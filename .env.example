VITE_MAP_PROVIDER=leaflet
VITE_MAPPLS_TOKEN=your_mappls_web_sdk_token_here
VITE_MAP_PROVIDER=leaflet

# PostgreSQL connection used by the Express API.
# Create this database in pgAdmin, then paste the matching URL here or in .env.local.
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/parksight_ai
API_PORT=8001
APP_SESSION_SECRET=replace_with_a_long_random_secret

# Used only when PostgreSQL is unreachable.
OFFLINE_LOGIN_EMAIL=officer@parksight.ai
OFFLINE_LOGIN_PASSWORD=Password1

# Seeded automatically on API startup so judges can log in without signup.
JUDGE_LOGIN_EMAIL=judge@parksight.ai
JUDGE_LOGIN_PASSWORD=Judge@123
JUDGE_LOGIN_NAME=ParkSight Judge
